{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    // deps ship conflicting global declarations (bun-types vs vite/client)
    "skipLibCheck": true,
    "types": ["vite/client", "bun"],

    // Path alias
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
